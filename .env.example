# Copy this file to .env and fill in your Neon connection details.
# .env is gitignored. Never commit the real credentials.
#
# Get these from Neon console: Dashboard → your project → Connect
#   - Toggle OFF "Connection pooling" to get the DIRECT URL (recommended for Spring Boot + Hikari).
#   - Hostname should NOT contain `-pooler`.

DB_URL=jdbc:postgresql://ep-xxxxx.<region>.aws.neon.tech/<database>?sslmode=require&channelBinding=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_password_here
DB_DRIVER=org.postgresql.Driver

# Server
PORT=8080
